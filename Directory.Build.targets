<Project>
    <PropertyGroup Condition="$(MSBuildProjectName) != 'GatheringPathRenderer'">
        <!-- Version scheme: A.B.C.(D*100+E)
             A.B.C.D = upstream version from PunishXIV/Questionable
             E = downstream patch counter (01~99), reset per upstream release
             Current: upstream 15.756.3.58 + downstream 01 -->
        <Version>15.756.3.5801</Version>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);MSB3277;CA1506</NoWarn>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277;CA1506</MSBuildWarningsAsMessages>
    </PropertyGroup>
</Project>
